# ── Azure OpenAI ────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_MAPPER_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VALIDATOR_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Azure Cosmos DB (leave blank for local JSON fallback) ──────
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=excel_ingestion
COSMOS_CONTAINER=results

# ── Azure Data Lake Storage Gen2 (leave blank for local ./uploads/ fallback)
ADLS_ACCOUNT_NAME=
ADLS_ACCOUNT_KEY=
ADLS_FILESYSTEM=excel-uploads
ADLS_RETENTION_DAYS=7

# ── Azure Log Analytics (leave blank for stdout JSON logging) ──
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_SHARED_KEY=

# ── Azure AD / Auth (leave blank to disable auth in local dev) ─
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# ── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Misc ────────────────────────────────────────────────────────
API_KEY=
LOG_LEVEL=INFO
